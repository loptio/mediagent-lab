# 複製成 .env 再填入；.env 不進 git，密鑰絕不寫在程式碼中。
DATABASE_URL=postgresql+psycopg://mediagent:mediagent@localhost:5432/mediagent
# 簽發 Access Token 用，至少 32 個字元
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# 平台憑證加密金鑰（Fernet），可用逗號分隔多把以輪替；第一把用來加密
# 產生方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEYS=
# 開發模式：允許以 X-Dev-User 標頭代替登入。正式環境必須為 0
DEV_MODE=0
# 外部定時任務呼叫 /api/v1/internal/* 時放在 X-Cron-Secret 標頭的隨機字串；沒有設定時內部端點一律拒絕
CRON_SECRET=
# 服務內每分鐘檢查到期的排程與需要恢復的發佈；設為 0 可關閉（只靠外部定時任務）
SCHEDULER_ENABLED=1
# 圖片：存放目錄與平台讀取圖片用的網址前綴。本機預設 /media（由後端提供，只有 Discord 用附件上傳時可用）。
# Threads、Instagram 由平台主動下載圖片，正式環境必須設成平台連得到的公開 https 網址
MEDIA_BASE_URL=/media
# 前面有幾層受信任的反向代理：本機直接連 8000 為 0；部署在 Render 等平台的代理後面為 1。
# 登入限流靠它取得真正的用戶端 IP；設錯會讓全部使用者共用一個限額，或讓攻擊者自己填 IP 繞過限流
TRUSTED_PROXY_HOPS=0

# ---- 平台授權（OAuth）：連結 Threads 時才需要 ----
# Meta 開發者網站 → App → Use cases → Threads → Settings 頁面上的值
THREADS_APP_ID=
THREADS_APP_SECRET=
# 平台把瀏覽器導回來的後端網址；必須是 HTTPS，並在 Meta 後台登記
# {OAUTH_REDIRECT_BASE_URL}/api/v1/platform-accounts/oauth/callback
OAUTH_REDIRECT_BASE_URL=https://localhost:8443
# 簽章 OAuth state 用的隨機字串；沒有設定時沿用 JWT_SECRET
OAUTH_STATE_SECRET=
